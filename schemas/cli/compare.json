{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgectl/cli/compare.json",
  "title": "compare output",
  "type": "object",
  "properties": {
    "pr": {
      "$ref": "../defs.json#/$defs/pr"
    },
    "from_sha": {
      "$ref": "../defs.json#/$defs/sha"
    },
    "to_sha": {
      "$ref": "../defs.json#/$defs/sha"
    },
    "status": {
      "enum": [
        "ahead",
        "behind",
        "diverged",
        "identical",
        "unavailable"
      ]
    },
    "diff": {
      "type": [
        "string",
        "null"
      ],
      "x-untrusted": true,
      "description": "Untrusted: the sanitized unified diff from from_sha to to_sha: present on ahead, empty on identical, null on behind, diverged and unavailable. Absent when `--no-diff` is given: the key is then not there at all, and the same rules hold for it whenever it is present. The output carries no marker of the flag, so the schema cannot require the key: a consumer that did not pass `--no-diff` treats a missing `diff` as a contract break."
    }
  },
  "additionalProperties": false,
  "required": [
    "pr",
    "from_sha",
    "to_sha",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "behind",
              "diverged",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "diff": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "diff": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "identical"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "diff": {
            "const": ""
          }
        }
      }
    }
  ]
}
