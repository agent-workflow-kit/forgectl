{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgectl/cli/snapshot.json",
  "title": "snapshot output",
  "description": "The PR object plus the parts below. Lists have a fixed order, so two snapshots compare directly, excluding fetched_at and rate_limit.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../defs.json#/$defs/pr_fields"
    },
    {
      "properties": {
        "head": {
          "required": [
            "pushed_at",
            "pushed_at_source"
          ],
          "oneOf": [
            {
              "properties": {
                "pushed_at": {
                  "allOf": [
                    {
                      "$ref": "../defs.json#/$defs/ts"
                    },
                    {
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
                    },
                    {
                      "not": {
                        "pattern": "\n"
                      }
                    }
                  ]
                },
                "pushed_at_source": {
                  "enum": [
                    "push_event",
                    "commit_date"
                  ]
                }
              }
            },
            {
              "properties": {
                "pushed_at": {
                  "type": "null"
                },
                "pushed_at_source": {
                  "type": "null"
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "incomplete": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "incomplete": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "review_requests": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/review_request"
      }
    },
    "teams_visible": {
      "type": "boolean",
      "description": "false when the account cannot see team requests, so the absence of a team means nothing."
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/review"
      }
    },
    "latest_by_reviewer": {
      "$ref": "../defs.json#/$defs/latest_by_reviewer"
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/thread"
      }
    },
    "ci": {
      "$ref": "../defs.json#/$defs/ci"
    },
    "rate_limit": {
      "$ref": "../defs.json#/$defs/rate_limit"
    },
    "complete": {
      "type": "boolean"
    },
    "incomplete": {
      "type": "array",
      "items": {
        "enum": [
          "review_requests",
          "reviews",
          "threads",
          "ci"
        ]
      },
      "uniqueItems": true,
      "description": "Names of the parts that are not complete."
    },
    "fetched_at": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "activity": {
      "type": "object",
      "properties": {
        "comments_total": {
          "type": "integer",
          "minimum": 0,
          "description": "All comments across all threads, mine and ignored authors' included."
        },
        "unresolved_threads": {
          "type": "integer",
          "minimum": 0,
          "description": "Threads that are not resolved."
        },
        "others_since_push": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Comments plus reviews (GitLab: approvals) by an account that is not me and not ignored, after head.pushed_at; null when pushed_at is null."
        },
        "awaiting_my_reply": {
          "type": "integer",
          "minimum": 0,
          "description": "Unresolved threads whose last comment by a non-ignored author is not mine."
        }
      },
      "required": [
        "comments_total",
        "unresolved_threads",
        "others_since_push",
        "awaiting_my_reply"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "pr",
    "repo",
    "pr_id",
    "number",
    "url",
    "backend",
    "title",
    "body",
    "author",
    "state",
    "draft",
    "created_at",
    "updated_at",
    "closed_at",
    "merged_at",
    "merged_by",
    "labels",
    "author_association",
    "head",
    "base",
    "merged_head_sha",
    "merge_commit_sha",
    "head_fetch_ref",
    "mergeable",
    "blocked_by",
    "auto_merge",
    "merge_queue",
    "merge_methods_allowed",
    "additions",
    "deletions",
    "changed_files",
    "review_decision",
    "approvals",
    "approvals_at_head",
    "review_requests",
    "teams_visible",
    "reviews",
    "latest_by_reviewer",
    "threads",
    "ci",
    "activity",
    "rate_limit",
    "complete",
    "incomplete",
    "fetched_at"
  ]
}
