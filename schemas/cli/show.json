{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgectl/cli/show.json",
  "title": "show output: the PR object",
  "type": "object",
  "allOf": [
    {
      "$ref": "../defs.json#/$defs/pr_fields"
    },
    {
      "properties": {
        "head": {
          "properties": {
            "pushed_at": false,
            "pushed_at_source": false
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "required": [
    "pr",
    "repo",
    "repo_id",
    "pr_id",
    "number",
    "url",
    "backend",
    "title",
    "body",
    "author",
    "state",
    "draft",
    "created_at",
    "updated_at",
    "closed_at",
    "merged_at",
    "merged_by",
    "labels",
    "author_association",
    "head",
    "base",
    "merged_head_sha",
    "merge_commit_sha",
    "head_fetch_ref",
    "mergeable",
    "blocked_by",
    "auto_merge",
    "merge_queue",
    "merge_methods_allowed",
    "additions",
    "deletions",
    "changed_files",
    "review_decision",
    "approvals",
    "approvals_at_head",
    "approvals_left"
  ]
}
