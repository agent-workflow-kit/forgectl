{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgectl/hooks/pre-merge.json",
  "title": "pre-merge hook payload (stdin)",
  "description": "After the checks and confirmation, before the merge call. Can veto or escalate.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "forgectl"
    },
    "hook": {
      "const": "pre-merge"
    },
    "object_type": {
      "const": "pr"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/pr"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "head_sha": {
      "$ref": "../defs.json#/$defs/sha"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "decision_ids": {
      "$ref": "../defs.json#/$defs/decision_ids"
    },
    "action": {
      "const": "merge"
    },
    "auto": {
      "type": "boolean"
    },
    "method": {
      "enum": [
        "squash",
        "merge",
        "rebase",
        null
      ]
    },
    "base_ref": {
      "type": "string",
      "x-untrusted": true,
      "description": "Untrusted: the PR's base.",
      "x-one-line": true
    },
    "expected_head": {
      "$ref": "../defs.json#/$defs/sha",
      "description": "Given, or pinned by an interactive run's first read."
    },
    "expected_base": {
      "type": "string",
      "x-untrusted": true,
      "description": "Untrusted: the expected base: given, or pinned by an interactive run's first read.",
      "x-one-line": true
    },
    "blocked_by": {
      "$ref": "../defs.json#/$defs/blocked_by"
    },
    "override_blocks": {
      "type": "boolean"
    },
    "ci": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "passing",
            "failing",
            "pending",
            "none"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "x-untrusted": true,
                "description": "Untrusted: the check's name, for comparison by equality.",
                "minLength": 1,
                "x-one-line": true
              },
              "state": {
                "enum": [
                  "passing",
                  "failing",
                  "pending",
                  "skipped"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "state"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "checks"
      ],
      "description": "The merge's CI reading: a hook's environment has no token_env variable, so a gate may be unable to call forgectl ci."
    },
    "override_escalation": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "repo",
    "head_sha",
    "actor",
    "decision_ids",
    "action",
    "auto",
    "method",
    "base_ref",
    "expected_head",
    "expected_base",
    "blocked_by",
    "override_blocks",
    "ci",
    "override_escalation"
  ]
}
