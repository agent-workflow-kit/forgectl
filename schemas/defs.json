              "items": {
                "type": "string",
                "x-untrusted": true,
                "x-one-line": true,
                "maxLength": 40
              },
              "description": "The codes of the snapshot's blocked_by, at most 16 (the first 16 when there are more), each sanitized and at most 40 characters; an entry without a string code is \"unknown\"."
            },
            "others_since_push": {
              "type": [
                "integer",
                "null"
