        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "side": {
          "enum": [
            "left",
            "right",
            null
          ]
        },
        "start_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
