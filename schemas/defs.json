        "path",
        "line",
        "side",
        "start_line"
      ]
    },
    "error_details": {
      "type": [
        "object",
        "null"
      ],
      "x-untrusted": true,
      "description": "Untrusted: may hold host text. Each key belongs to the code or reason that names it.",
