        "blocked_by": {
          "$ref": "#/$defs/blocked_by",
          "description": "not_ready."
        },
        "head_sha": {
          "$ref": "#/$defs/sha",
          "description": "stale_head (when known), merge_unverified: the head read."
        },
        "base_ref": {
          "type": "string",
          "x-untrusted": true,
          "description": "Untrusted: stale_base: the PR's base.",
