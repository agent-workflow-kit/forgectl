        "repo": {
          "$ref": "#/$defs/repo_id"
        },
        "number": {
          "$ref": "#/$defs/number"
        },
        "url": {
          "type": "string",
          "x-untrusted": true,
          "description": "Untrusted: the PR's page.",
          "pattern": "^https://",
          "minLength": 9
        },
        "title": {
          "type": "string",
          "x-untrusted": true,
          "description": "Untrusted: the PR's title.",
          "x-one-line": true
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "state": {
          "enum": [
            "open",
            "closed",
            "merged"
          ]
        },
        "draft": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "x-untrusted": true,
